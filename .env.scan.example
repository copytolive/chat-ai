# Copy this file to .env for QR-scan launch mode.
# This mode uses the unofficial Baileys WhatsApp Web protocol. For official business-critical use, prefer .env.example with WA_PROVIDER=cloud.

PORT=3847
HOST=127.0.0.1
NODE_ENV=production
RELEASE_VERSION=launch-scan-v1
TRUST_PROXY=true

# Protect the browser console and admin mutations.
SCANNER_TOKEN=replace-with-a-long-random-secret
ADMIN_TOKEN=replace-with-a-different-long-random-secret

# Scan once -> save session -> reply automatically -> reconnect after restart.
WA_PROVIDER=baileys
PRODUCTION_REQUIRE_CLOUD=false
ALLOW_UNOFFICIAL_WA=true
AUTOMATION_ENABLED=true
WA_AUTH_DIR=/data/wa-auth
WA_REPLY_GROUPS=false
WA_ALLOWED_JIDS=
WA_LOG_LEVEL=warn

# AI endpoint. Any OpenAI-compatible local or remote endpoint can be used.
AI_ENABLED=true
AI_BASE_URL=http://host.docker.internal:11434/v1
AI_MODEL=replace-with-model-name
AI_API_KEY=
AI_TIMEOUT_MS=60000
AI_FALLBACK_BASE_URL=
AI_FALLBACK_MODEL=
AI_FALLBACK_API_KEY=

# Marketing brain
MARKETING_ENABLED=true
MARKETING_REQUIRE_KNOWLEDGE=true
MARKETING_AGENT_NAME=AI Assistant
MARKETING_AGENT_ROLE=conversation marketing assistant
MARKETING_COMPANY_NAME=Replace Company
MARKETING_BUSINESS=Replace with reviewed business facts and offer scope.
MARKETING_VALUE_PROPOSITION=Replace with a reviewed value proposition.
MARKETING_PURPOSE=Understand fit and help the prospect choose a useful next step.
MARKETING_CTA=Offer one verified next step when the prospect is ready.
MARKETING_LOCALE=id-ID
MARKETING_MAX_TURNS=12
MARKETING_SESSION_TTL_MINUTES=1440

# Reviewed knowledge
KNOWLEDGE_FILE=/data/knowledge.json
KNOWLEDGE_FACTS=
STATE_FILE=/data/state.json

# Self-contained human takeover inbox. No external CRM is required to become ready.
REQUIRE_HANDOFF_FOR_READY=true
HANDOFF_MODE=local
HANDOFF_QUEUE_DIR=/data/handoff-queue
HANDOFF_REQUIRE_ENCRYPTED_QUEUE=true
# Exactly 32 random bytes represented as 64 hex characters or base64.
HANDOFF_QUEUE_ENCRYPTION_KEY=replace-with-32-byte-key

# HTTP protection
SCANNER_RATE_LIMIT_PER_MINUTE=120
MAX_INPUT_CHARS=6000
MAX_REPLY_CHARS=6000
LOG_LEVEL=info
