# Legacy-compatible HTTP port
PORT=3847
# Safe default: loopback only. Set 0.0.0.0 only behind a protected reverse proxy.
HOST=127.0.0.1

# Required when HOST is not loopback; protects scanner/status/preview endpoints.
SCANNER_TOKEN=
# Optional separate token for POST /reconnect.
ADMIN_TOKEN=

# Keep auth outside the repository in production, e.g. /var/lib/chat-ai/wa-auth
WA_AUTH_DIR=.auth/whatsapp
WA_REPLY_GROUPS=false
# Optional comma-separated exact JIDs, e.g. 628123456789@s.whatsapp.net
WA_ALLOWED_JIDS=

# AI adapter
AI_ENABLED=false
# OpenAI-compatible base URL WITHOUT /chat/completions.
# Example local server: http://127.0.0.1:11434/v1
AI_BASE_URL=http://127.0.0.1:11434/v1
AI_MODEL=
AI_API_KEY=
AI_TIMEOUT_MS=60000
SYSTEM_PROMPT=You are a helpful WhatsApp assistant. Reply clearly and concisely.

# Conversation marketing agent (SalesGPT-inspired staged architecture)
MARKETING_ENABLED=false
MARKETING_AGENT_NAME=AI Assistant
MARKETING_AGENT_ROLE=conversation marketing assistant
MARKETING_COMPANY_NAME=Example Company
MARKETING_BUSINESS=Describe what the company sells, who it serves, and the facts the AI is allowed to use.
MARKETING_VALUE_PROPOSITION=Describe the strongest verified customer value without unsupported claims.
MARKETING_PURPOSE=Understand whether the offer is relevant and help the prospect choose a useful next step.
MARKETING_CTA=Offer a demo, meeting, trial, or purchase path only when the prospect is ready.
MARKETING_LOCALE=id-ID
MARKETING_MAX_TURNS=12
MARKETING_SESSION_TTL_MINUTES=1440
MARKETING_OPT_OUT_MESSAGE=Baik. Saya hentikan balasan pemasaran otomatis untuk percakapan ini.
MARKETING_HANDOFF_MESSAGE=Baik. Saya hentikan balasan otomatis dan meneruskan percakapan ini untuk ditangani manusia.

# Reply controls
MAX_INPUT_CHARS=6000
MAX_REPLY_CHARS=6000
