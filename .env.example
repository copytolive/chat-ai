# Runtime
PORT=3847
HOST=127.0.0.1
NODE_ENV=production
RELEASE_VERSION=launch-v1
TRUST_PROXY=true

# Protected operator surfaces
SCANNER_TOKEN=
ADMIN_TOKEN=

# Global automation kill switch. Production should only set true after /ready passes.
AUTOMATION_ENABLED=false
REQUIRE_MARKETING_FOR_READY=true

# WhatsApp provider
WA_PROVIDER=cloud
PRODUCTION_REQUIRE_CLOUD=true
ALLOW_UNOFFICIAL_WA=false

# Official WhatsApp Business Platform / Cloud API
WA_CLOUD_ACCESS_TOKEN=
WA_CLOUD_PHONE_NUMBER_ID=
WA_CLOUD_VERIFY_TOKEN=
WA_CLOUD_APP_SECRET=
WA_GRAPH_VERSION=v26.0
WA_SEND_TIMEOUT_MS=15000
WA_DEDUPE_TTL_MS=86400000
WEBHOOK_RATE_LIMIT_PER_MINUTE=600

# Baileys development-only settings
WA_AUTH_DIR=.auth/whatsapp
WA_REPLY_GROUPS=false
WA_ALLOWED_JIDS=
WA_LOG_LEVEL=warn

# AI primary endpoint (OpenAI-compatible)
AI_ENABLED=true
AI_BASE_URL=
AI_MODEL=
AI_API_KEY=
AI_TIMEOUT_MS=60000

# Optional fallback model/provider
AI_FALLBACK_BASE_URL=
AI_FALLBACK_MODEL=
AI_FALLBACK_API_KEY=

# Conversation marketing
MARKETING_ENABLED=true
MARKETING_AGENT_NAME=AI Assistant
MARKETING_AGENT_ROLE=conversation marketing assistant
MARKETING_COMPANY_NAME=
MARKETING_BUSINESS=
MARKETING_VALUE_PROPOSITION=
MARKETING_PURPOSE=Understand fit and help the prospect choose a useful next step.
MARKETING_CTA=Offer one verified next step when the prospect is ready.
MARKETING_LOCALE=id-ID
MARKETING_MAX_TURNS=12
MARKETING_SESSION_TTL_MINUTES=1440
MARKETING_REQUIRE_KNOWLEDGE=true
MARKETING_OPT_OUT_MESSAGE=Baik. Saya hentikan balasan pemasaran otomatis untuk percakapan ini.
MARKETING_OPT_IN_MESSAGE=Baik. Balasan otomatis diaktifkan kembali untuk percakapan ini.
MARKETING_HANDOFF_MESSAGE=Baik. Saya hentikan balasan otomatis dan meneruskan percakapan ini untuk ditangani manusia.

# Verified facts
KNOWLEDGE_FILE=/data/knowledge.json
KNOWLEDGE_FACTS=

# Durable suppression/lead metadata
STATE_FILE=/data/state.json

# HTTP protection
SCANNER_RATE_LIMIT_PER_MINUTE=120
MAX_INPUT_CHARS=6000
MAX_REPLY_CHARS=6000
LOG_LEVEL=info
